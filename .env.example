# Neon -> Dashboard -> Connect -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional Vercel Blob token for profile image uploads
BLOB_READ_WRITE_TOKEN=
# Payment adapter is intentionally disabled until a real provider account is configured.
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=https://your-domain.example/account/billing
# Minecraft delivery adapter. Must point to a trusted private bridge you control; never expose RCON publicly.
MINECRAFT_BRIDGE_URL=
MINECRAFT_BRIDGE_TOKEN=
# Bootstrap admin: create with npm run admin:create after DB schema is applied
