import { NextRequest } from 'next/server';
import bcrypt from 'bcryptjs';
import { put } from '@vercel/blob';
import { sql } from '@/lib/db';
import { makeSession,setSession,clearSession } from '@/lib/auth';
import { requireUser,requirePermission,hasPermission,audit,HttpError,jsonError,bodyJson } from '@/lib/security';
export const runtime='nodejs';
const staffRoleIds=['owner','deputy','management','curator','tech_admin','support','moderator','trainee'];
const allowedByCurator=['trainee','moderator','support'];
const seedProducts=[
 ['opka-deputy','👑 Заместитель','rank','main',75,'ОПКА: Заместитель. Осталось 1 место.'],['chief-admin','📈 Гл. Администратор','rank','main',75,'Главный администратор'],['administrator','🚀 Администратор','rank','main',70,'Администратор проекта'],['developer','🔥 Разработчик','privilege','main',75,'Привилегия разработчика'],['chief-console','😎 Гл.Консоль','privilege','main',70,'Главная консоль'],['console','📱 Консоль','privilege','main',70,'Доступ к консоли'],['owner-rank','Владелец','privilege','main',50,'Игровая привилегия «Владелец»; не роль владельца сайта'],['creator','Создатель','privilege','main',50,'Привилегия создателя'],['operator','Оператор','privilege','main',50,'Оператор сервера'],['anti-griefer','Анти-Грифер','privilege','main',50,'Защита от гриферов'],['support-rank','Поддержка','privilege','main',50,'Игровая привилегия поддержки'],['helper','Хелпер','privilege','main',50,'Помощник сервера'],['admin-rank','Админ','privilege','main',50,'Игровая привилегия администратора'],['moderator-rank','Модератор','privilege','main',50,'Игровая привилегия модератора'],['creative','Креатив','privilege','main',50,'Режим креатива'],['premium','Премиум','privilege','main',50,'Премиум'],['vip','Вип','privilege','main',50,'VIP'],['fly','Флай','privilege','main',50,'Полёт'],['donate','Донат','privilege','main',0,'Донат-привилегия'],['beta-tester','❗ БЕТА-ТЕСТЕР [NEW]','privilege','main',0,'Статус бета-тестера'],['best-player','⚡ Статус ★ Лучший игрок ★','privilege','main',0,'Статус лучшего игрока'],['mvp-plus-plus','🪎 MVP++','privilege','main',0,'MVP++'],['mvp-plus','🍯 MVP+','privilege','main',0,'MVP+'],['mvp','🎗 MVP','privilege','main',0,'MVP'],['max-money','Максимальное количество денег','economy','main',0,'До 18 квинтиллионов игровой валюты'],['wipe-100b','Сохранение валюты после вайпа 100.000.000.000$','economy','main',0,'Сохранение игровой валюты после вайпа'],['wipe-100m','Сохранение валюты после вайпа 100.000.000$','economy','main',0,'Сохранение игровой валюты после вайпа'],['unlock-all','Разблокировка всего','economy','main',0,'Разблокировка доступного контента'],['unlock-console','Разблокировка консоли','economy','main',0,'Разблокировка консоли'],['unlock-privilege','Разблокировка привилегии','economy','main',0,'Разблокировка привилегии'],['unban','Разбан по нику','service','main',0,'Заявка на снятие бана'],['unmute','Размут','service','main',0,'Заявка на снятие мута'],['mega-box','Мега-Ящик','consumable','main',0,'Мега-ящик'],['title-box','Титул-Ящик','consumable','main',0,'Ящик титулов'],['companion-box','Компаньон-Ящик','consumable','main',0,'Ящик компаньонов'],['pet-box','Питомец-Ящик','consumable','main',0,'Ящик питомцев'],['hologram-box','Голограмм-Ящик','consumable','main',0,'Ящик голограмм'],['staff-deputy','Заместитель (персонал)','rank','staff',0,'Магазин персонала',true],['staff-chief-admin','Гл. Администратор (персонал)','rank','staff',0,'Магазин персонала',true],['staff-admin','Администратор (персонал)','rank','staff',0,'Магазин персонала',true],['staff-console','Консоль (персонал)','privilege','staff',0,'Магазин персонала',true],['staff-chief-console','Гл.Консоль (персонал)','privilege','staff',0,'Магазин персонала',true],['staff-owner','Владелец (игровая привилегия, персонал)','privilege','staff',0,'Не является ролью владельца проекта',true],['staff-creator','Создатель (персонал)','privilege','staff',0,'Магазин персонала',true],['staff-pet-box','Пет кейс','consumable','staff',0,'Магазин персонала',true],['staff-hologram-box','Голограм кейс','consumable','staff',0,'Магазин персонала',true],['staff-companion-box','Компаньон кейс','consumable','staff',0,'Магазин персонала',true],['staff-title-box','Титул кейс','consumable','staff',0,'Магазин персонала',true],['staff-mega-box','Мега ящик','consumable','staff',0,'Магазин персонала',true],['staff-unmute','Размут (персонал)','service','staff',0,'Магазин персонала',true],['staff-unban','Разбан (персонал)','service','staff',0,'Магазин персонала',true]
];
async function route(req:NextRequest,{params}:{params:Promise<{path:string[]}>}) {
 const {path}=await params, key=path.join('/'), method=req.method, db=sql();
 if(key==='health'&&method==='GET') return Response.json({ok:true,service:'Hypego',database:'configured'});
 if(key==='auth/register'&&method==='POST') { const b=await bodyJson(req); const username=String(b.username||'').trim(),email=String(b.email||'').trim().toLowerCase(),password=String(b.password||''); if(!/^[A-Za-z0-9_]{3,24}$/.test(username))throw new HttpError(400,'Ник: 3–24 символа, латиница, цифры и _'); if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw new HttpError(400,'Укажи корректный email'); if(password.length<10)throw new HttpError(400,'Пароль должен содержать минимум 10 символов'); const hash=await bcrypt.hash(password,12); const rows=await db`INSERT INTO users(username,email,password_hash,display_name) VALUES(${username},${email},${hash},${username}) RETURNING id,username,email`; await db`INSERT INTO user_roles(user_id,role_id) VALUES(${rows[0].id},'player')`; await audit(rows[0].id,'auth.register','user',rows[0].id); await setSession(await makeSession(rows[0] as any)); return Response.json({user:rows[0]}, {status:201}); }
 if(key==='auth/login'&&method==='POST') { const b=await bodyJson(req),login=String(b.login||'').trim(),password=String(b.password||''); const rows=await db`SELECT id,username,email,password_hash,is_banned FROM users WHERE lower(email)=lower(${login}) OR lower(username)=lower(${login}) LIMIT 1`; if(!rows.length||!await bcrypt.compare(password,rows[0].password_hash))throw new HttpError(401,'Неверный логин или пароль'); if(rows[0].is_banned)throw new HttpError(403,'Аккаунт заблокирован'); await setSession(await makeSession(rows[0] as any)); await audit(rows[0].id,'auth.login','user',rows[0].id); return Response.json({user:{id:rows[0].id,username:rows[0].username,email:rows[0].email}}); }
 if(key==='auth/logout'&&method==='POST'){await clearSession();return Response.json({ok:true});}
 if(key==='me'&&method==='GET'){const u=await requireUser();const roles=await db`SELECT r.id,r.title,r.rank FROM user_roles ur JOIN roles r ON r.id=ur.role_id WHERE ur.user_id=${u.id} ORDER BY r.rank DESC`;return Response.json({user:u,roles});}
 if(key==='profile'&&method==='PATCH'){const u=await requireUser(),b=await bodyJson(req);const display=String(b.display_name??u.display_name??u.username).slice(0,40),bio=String(b.bio??u.bio??'').slice(0,500),color=String(b.nickname_color??u.nickname_color);if(!/^#[0-9a-fA-F]{6}$/.test(color))throw new HttpError(400,'Некорректный цвет ника');const steam=String(b.steam_id??u.steam_id??'').slice(0,80),birth=b.birth_date||null;const rows=await db`UPDATE users SET display_name=${display},bio=${bio},nickname_color=${color},steam_id=${steam||null},birth_date=${birth},updated_at=NOW() WHERE id=${u.id} RETURNING id,username,display_name,bio,nickname_color,steam_id,birth_date,avatar_url,banner_url`;await audit(u.id,'profile.update','user',u.id);return Response.json({user:rows[0]});}
 if(key==='profile/upload'&&method==='POST'){const u=await requireUser();if(!process.env.BLOB_READ_WRITE_TOKEN)throw new HttpError(503,'Загрузка изображений недоступна: добавь BLOB_READ_WRITE_TOKEN в Vercel');const form=await req.formData(),file=form.get('file'),kind=String(form.get('kind')||'avatar');if(!(file instanceof File)||!['avatar','banner'].includes(kind))throw new HttpError(400,'Нужен файл и тип avatar/banner');if(!file.type.startsWith('image/')||file.size>5*1024*1024)throw new HttpError(400,'Разрешены изображения до 5 МБ');const blob=await put(`profiles/${u.id}/${kind}-${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g,'_')}`,file,{access:'public',token:process.env.BLOB_READ_WRITE_TOKEN});if(kind==='avatar')await db`UPDATE users SET avatar_url=${blob.url} WHERE id=${u.id}`;else await db`UPDATE users SET banner_url=${blob.url} WHERE id=${u.id}`;await audit(u.id,'profile.image.update','user',u.id,{kind});return Response.json({url:blob.url});}
 if(key==='players'&&method==='GET'){const q=(req.nextUrl.searchParams.get('q')||'').slice(0,40);const rows=await db`SELECT id,username,display_name,avatar_url,nickname_color,created_at FROM users WHERE username ILIKE ${'%'+q+'%'} ORDER BY username LIMIT 50`;return Response.json({players:rows});}
 if(key==='roles'&&method==='GET'){const u=await requireUser();const rows=await db`SELECT r.id,r.title,r.rank,EXISTS(SELECT 1 FROM user_roles ur WHERE ur.user_id=${u.id} AND ur.role_id=r.id) AS assigned FROM roles r ORDER BY r.rank DESC`;return Response.json({roles:rows});}
 if(key==='admin/users'&&method==='GET'){const actor=await requireUser();if(!await hasPermission(actor.id,'admin.users')&&!await hasPermission(actor.id,'staff.roles.assign_limited')&&!await hasPermission(actor.id,'staff.salary.manage'))throw new HttpError(403,'Недостаточно прав');const q=(req.nextUrl.searchParams.get('q')||'').slice(0,50);const rows=await db`SELECT u.id,u.username,u.email,u.is_banned,u.balance_cents,u.staff_salary,u.created_at,COALESCE(json_agg(json_build_object('id',r.id,'title',r.title)) FILTER(WHERE r.id IS NOT NULL),'[]') roles FROM users u LEFT JOIN user_roles ur ON ur.user_id=u.id LEFT JOIN roles r ON r.id=ur.role_id WHERE u.username ILIKE ${'%'+q+'%'} OR u.email ILIKE ${'%'+q+'%'} GROUP BY u.id ORDER BY u.created_at DESC LIMIT 100`;return Response.json({users:rows});}
 if(key==='admin/roles'&&method==='POST'){const actor=await requireUser(),b=await bodyJson(req),target=String(b.user_id||''),role=String(b.role_id||'');if(!staffRoleIds.includes(role)&&role!=='player')throw new HttpError(400,'Неизвестная роль');if(role==='owner'&&!(await hasPermission(actor.id,'site.settings')))throw new HttpError(403,'Роль владельца проекта назначается только текущим владельцем');const canAny=await hasPermission(actor.id,'staff.roles.assign_any'),canLimited=await hasPermission(actor.id,'staff.roles.assign_limited');if(!canAny&&!canLimited)throw new HttpError(403,'Нет права выдавать роли');if(role==='owner'&&!canAny)throw new HttpError(403,'Нельзя выдать владельца проекта');if(!canAny&&!allowedByCurator.includes(role))throw new HttpError(403,'Куратор может выдавать только стажёра, модератора и техподдержку');const t=await db`SELECT id FROM users WHERE id=${target} LIMIT 1`;if(!t.length)throw new HttpError(404,'Пользователь не найден');if(role==='owner'){const existing=await db`SELECT 1 FROM user_roles WHERE user_id=${target} AND role_id='owner'`;if(!existing.length){await db`DELETE FROM user_roles WHERE role_id='owner'`;}}await db`INSERT INTO user_roles(user_id,role_id,assigned_by) VALUES(${target},${role},${actor.id}) ON CONFLICT DO NOTHING`;await audit(actor.id,'staff.role.assign','user',target,{role});return Response.json({ok:true});}
 if(key==='admin/roles'&&method==='DELETE'){const actor=await requireUser(),b=await bodyJson(req),target=String(b.user_id||''),role=String(b.role_id||'');if(role==='owner')throw new HttpError(403,'Роль владельца нельзя снять через этот endpoint');if(!await hasPermission(actor.id,'staff.roles.assign_any')&&!await hasPermission(actor.id,'staff.roles.assign_limited'))throw new HttpError(403,'Нет права снимать роли');if(!await hasPermission(actor.id,'staff.roles.assign_any')&&!allowedByCurator.includes(role))throw new HttpError(403,'Недостаточно прав');await db`DELETE FROM user_roles WHERE user_id=${target} AND role_id=${role}`;await audit(actor.id,'staff.role.remove','user',target,{role});return Response.json({ok:true});}
 if(key==='admin/salary'&&method==='POST'){const actor=await requirePermission('staff.salary.manage'),b=await bodyJson(req),target=String(b.user_id||''),amount=Number(b.amount),reason=String(b.reason||'').trim().slice(0,200);if(!Number.isSafeInteger(amount)||amount===0||Math.abs(amount)>1000000000)throw new HttpError(400,'Укажи корректную сумму');if(reason.length<3)throw new HttpError(400,'Укажи причину начисления/списания');if(amount<0){const rows=await db`SELECT staff_salary FROM users WHERE id=${target}`;if(!rows.length||Number(rows[0].staff_salary)<Math.abs(amount))throw new HttpError(400,'Недостаточно внутренней валюты');}const result=await db`UPDATE users SET staff_salary=staff_salary+${amount} WHERE id=${target} AND staff_salary+${amount}>=0 RETURNING staff_salary`;if(!result.length)throw new HttpError(400,'Не удалось изменить баланс');await db`INSERT INTO salary_transactions(user_id,actor_id,amount,reason) VALUES(${target},${actor.id},${amount},${reason})`;await audit(actor.id,'staff.salary.change','user',target,{amount,reason});return Response.json({ok:true,balance:result[0].staff_salary});}
 if(key==='admin/rules'&&method==='GET'){const rows=await db`SELECT id,title,body,sort_order,updated_at FROM rules ORDER BY sort_order,id`;return Response.json({rules:rows});}
 if(key==='admin/rules'&&method==='PUT'){const actor=await requirePermission('rules.edit'),b=await bodyJson(req),rules=Array.isArray(b.rules)?b.rules:[];if(rules.length>100)throw new HttpError(400,'Слишком много правил');for(let i=0;i<rules.length;i++){const r=rules[i],title=String(r.title||'').trim().slice(0,150),body=String(r.body||'').trim().slice(0,5000);if(!title||!body)continue;if(r.id)await db`UPDATE rules SET title=${title},body=${body},sort_order=${i},updated_by=${actor.id},updated_at=NOW() WHERE id=${r.id}`;else await db`INSERT INTO rules(title,body,sort_order,updated_by) VALUES(${title},${body},${i},${actor.id})`;}await audit(actor.id,'rules.update','rules',undefined,{count:rules.length});return Response.json({ok:true});}
 if(key==='rules'&&method==='GET'){const rows=await db`SELECT id,title,body,sort_order,updated_at FROM rules ORDER BY sort_order,id`;return Response.json({rules:rows});}
 if(key==='products/seed'&&method==='POST'){const actor=await requirePermission('products.manage');for(const p of seedProducts){const [slug,name,category,store,discount,description,requiresStaff]=p as any;await db`INSERT INTO products(slug,name,category,store,discount_percent,description,requires_staff,active,price_cents,currency) VALUES(${slug},${name},${category},${store},${discount},${description},${!!requiresStaff},TRUE,0,'EUR') ON CONFLICT(slug) DO NOTHING`;}await audit(actor.id,'products.seed','products');return Response.json({ok:true,count:seedProducts.length});}
 if(key==='products'&&method==='GET'){const u=await requireUser(),store=req.nextUrl.searchParams.get('store')==='staff'?'staff':'main';if(store==='staff'&&!await hasPermission(u.id,'shop.staff'))throw new HttpError(403,'Магазин персонала недоступен для вашей роли');const rows=await db`SELECT id,slug,name,description,category,store,price_cents,currency,discount_percent,stock,active,requires_staff FROM products WHERE active=TRUE AND store=${store} ORDER BY category,name`;return Response.json({products:rows});}
 if(key==='admin/products'&&method==='PATCH'){const actor=await requirePermission('products.manage'),b=await bodyJson(req),id=String(b.id||''),price=Number(b.price_cents),discount=Number(b.discount_percent),stock=b.stock===null?null:Number(b.stock);if(!Number.isSafeInteger(price)||price<0||!Number.isInteger(discount)||discount<0||discount>100)throw new HttpError(400,'Некорректная цена или скидка');const active=b.active===undefined?null:Boolean(b.active);const rows=active===null?await db`UPDATE products SET price_cents=${price},discount_percent=${discount},stock=${stock} WHERE id=${id} RETURNING id,name,price_cents,discount_percent,stock,active`:await db`UPDATE products SET price_cents=${price},discount_percent=${discount},stock=${stock},active=${active} WHERE id=${id} RETURNING id,name,price_cents,discount_percent,stock,active`;if(!rows.length)throw new HttpError(404,'Товар не найден');await audit(actor.id,'product.update','product',id,{price,discount,stock});return Response.json({product:rows[0]});}
 if(key==='orders'&&method==='POST'){const u=await requireUser(),b=await bodyJson(req),productId=String(b.product_id||''),target=String(b.minecraft_username||u.username).trim();if(!/^[A-Za-z0-9_]{3,24}$/.test(target))throw new HttpError(400,'Некорректный Minecraft-ник');const rows=await db`SELECT * FROM products WHERE id=${productId} AND active=TRUE LIMIT 1`;if(!rows.length)throw new HttpError(404,'Товар не найден');const p=rows[0];if(Number(p.price_cents)<=0)throw new HttpError(400,'У товара ещё не установлена цена. Покупка недоступна.');if(p.store==='staff'&&!await hasPermission(u.id,'shop.staff'))throw new HttpError(403,'Магазин персонала недоступен');if(p.slug==='owner-project'||p.name==='Владелец проекта')throw new HttpError(403,'Роль владельца проекта не продаётся');const amount=Math.round(Number(p.price_cents)*(100-Number(p.discount_percent))/100);const order=await db`INSERT INTO orders(user_id,product_id,username_target,amount_cents,currency,status) VALUES(${u.id},${p.id},${target},${amount},${p.currency},'pending') RETURNING id,status,amount_cents,currency`;return Response.json({order,payment:{enabled:false,message:'Платёжный провайдер не настроен. Заказ создан, списание и выдача не выполнялись.'}},{status:201});}
 if(key==='orders'&&method==='GET'){const u=await requireUser(),rows=await db`SELECT o.id,o.username_target,o.status,o.amount_cents,o.currency,o.created_at,o.paid_at,p.name AS product_name FROM orders o JOIN products p ON p.id=o.product_id WHERE o.user_id=${u.id} ORDER BY o.created_at DESC LIMIT 100`;return Response.json({orders:rows});}
 if(key==='billing/topup'&&method==='POST'){const u=await requireUser(),b=await bodyJson(req),amount=Number(b.amount_cents),currency=String(b.currency||'EUR').toUpperCase();if(!Number.isSafeInteger(amount)||amount<100||amount>100000000)throw new HttpError(400,'Пополнение должно быть от 1 до 1 000 000 в минимальных единицах валюты');if(!['KZT','RUB','EUR'].includes(currency))throw new HttpError(400,'Поддерживаются KZT, RUB и EUR');if(!process.env.PAYMENT_PROVIDER||process.env.PAYMENT_PROVIDER==='disabled')throw new HttpError(503,'Приём карт ещё не включён: подключите платёжного провайдера и webhook. Баланс не изменён.');throw new HttpError(503,'Провайдер задан, но адаптер этого провайдера не установлен. Не отправляйте деньги до настройки интеграции.');}
 if(key==='admin/orders'&&method==='GET'){await requirePermission('payments.manage');const rows=await db`SELECT o.*,u.username,p.name product_name FROM orders o JOIN users u ON u.id=o.user_id JOIN products p ON p.id=o.product_id ORDER BY o.created_at DESC LIMIT 200`;return Response.json({orders:rows});}
 if(key==='admin/punishments'&&method==='POST'){const actor=await requirePermission('punishments.manage'),b=await bodyJson(req),username=String(b.username||'').trim(),kind=String(b.kind||''),reason=String(b.reason||'').trim().slice(0,500),expires=b.expires_at||null;if(!/^[A-Za-z0-9_]{3,24}$/.test(username)||!['warn','mute','ban','unban','unmute'].includes(kind)||reason.length<3)throw new HttpError(400,'Проверь ник, тип наказания и причину');const rows=await db`INSERT INTO punishments(target_username,kind,reason,actor_id,expires_at) VALUES(${username},${kind},${reason},${actor.id},${expires}) RETURNING *`;await audit(actor.id,'punishment.create','punishment',rows[0].id,{username,kind});return Response.json({punishment:rows[0]},{status:201});}
 if(key==='admin/audit'&&method==='GET'){await requirePermission('audit.view');const rows=await db`SELECT a.id,a.action,a.target_type,a.target_id,a.details,a.created_at,u.username actor_username FROM audit_logs a LEFT JOIN users u ON u.id=a.actor_id ORDER BY a.created_at DESC LIMIT 200`;return Response.json({logs:rows});}
 if(key==='wall'&&method==='GET'){const profileId=req.nextUrl.searchParams.get('user_id');if(!profileId)throw new HttpError(400,'Нужен user_id');const rows=await db`SELECT w.id,w.body,w.created_at,u.username,u.display_name,u.avatar_url,u.nickname_color FROM wall_posts w JOIN users u ON u.id=w.author_id WHERE w.profile_user_id=${profileId} ORDER BY w.created_at DESC LIMIT 100`;return Response.json({posts:rows});}
 if(key==='wall'&&method==='POST'){const u=await requireUser(),b=await bodyJson(req),profileId=String(b.user_id||''),body=String(b.body||'').trim().slice(0,500);if(body.length<1)throw new HttpError(400,'Сообщение пустое');const rows=await db`INSERT INTO wall_posts(profile_user_id,author_id,body) VALUES(${profileId},${u.id},${body}) RETURNING *`;await audit(u.id,'wall.post','user',profileId);return Response.json({post:rows[0]},{status:201});}
 if(key==='tickets'&&method==='POST'){const u=await requireUser(),b=await bodyJson(req),subject=String(b.subject||'').trim().slice(0,120),body=String(b.body||'').trim().slice(0,4000);if(subject.length<3||body.length<5)throw new HttpError(400,'Заполни тему и сообщение');const rows=await db`INSERT INTO tickets(user_id,subject,body) VALUES(${u.id},${subject},${body}) RETURNING *`;return Response.json({ticket:rows[0]},{status:201});}
 if(key==='tickets'&&method==='GET'){const u=await requireUser();const staff=await hasPermission(u.id,'tickets.manage');const rows=staff?await db`SELECT t.*,u.username FROM tickets t JOIN users u ON u.id=t.user_id ORDER BY t.created_at DESC LIMIT 200`:await db`SELECT * FROM tickets WHERE user_id=${u.id} ORDER BY created_at DESC LIMIT 100`;return Response.json({tickets:rows});}
 if(key==='admin/privileges'&&method==='POST'){const actor=await requirePermission('admin.users'),b=await bodyJson(req),target=String(b.user_id||''),username=String(b.minecraft_username||''),productName=String(b.product_name||''),server=String(b.server_name||'Hypego'),expires=b.expires_at||null;if(!/^[A-Za-z0-9_]{3,24}$/.test(username)||productName.length<2)throw new HttpError(400,'Проверь ник и привилегию');const rows=await db`INSERT INTO privileges(user_id,server_name,minecraft_username,product_name,expires_at,status) VALUES(${target},${server},${username},${productName},${expires},'pending') RETURNING *`;await audit(actor.id,'privilege.issue.request','privilege',rows[0].id,{username,productName});return Response.json({privilege:rows[0],delivery:'pending',message:'Запись создана в Neon. Фактическая выдача на сервере требует настроенного Minecraft bridge.'},{status:201});}
 if(key==='admin/privileges'&&method==='GET'){await requirePermission('admin.users');const rows=await db`SELECT p.*,u.username account_username FROM privileges p JOIN users u ON u.id=p.user_id ORDER BY p.created_at DESC LIMIT 200`;return Response.json({privileges:rows});}
 throw new HttpError(404,'API endpoint не найден');
}
export async function GET(req:NextRequest,ctx:any){try{return await route(req,ctx)}catch(e){return jsonError(e)}}
export async function POST(req:NextRequest,ctx:any){try{return await route(req,ctx)}catch(e){return jsonError(e)}}
export async function PATCH(req:NextRequest,ctx:any){try{return await route(req,ctx)}catch(e){return jsonError(e)}}
export async function PUT(req:NextRequest,ctx:any){try{return await route(req,ctx)}catch(e){return jsonError(e)}}
export async function DELETE(req:NextRequest,ctx:any){try{return await route(req,ctx)}catch(e){return jsonError(e)}}
