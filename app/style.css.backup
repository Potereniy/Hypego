@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#090b12;--panel:#111521;--panel2:#151b2b;--line:#272d3e;--muted:#9099ae;--text:#f4f5fb;--accent:#a78bfa;--accent2:#67e8f9}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,system-ui,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0;color:inherit}button:disabled{opacity:.45;cursor:not-allowed}main{max-width:1440px;margin:auto;padding:0 34px}.top{height:82px;display:flex;align-items:center;gap:34px;border-bottom:1px solid #ffffff12}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:white;font-weight:800;letter-spacing:2px;white-space:nowrap}.brandMark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#a78bfa,#67e8f9);color:#090b12;font-size:21px;font-weight:900}.top nav{display:flex;gap:7px;align-items:center;flex:1}.top nav button,.outline{background:transparent;border:1px solid #ffffff24;border-radius:10px;padding:10px 14px;color:#c9cede;font-size:12px;transition:.2s}.top nav button{border-color:transparent}.top nav button:hover,.outline:hover{border-color:#a78bfa;color:white;background:#a78bfa14}.right{display:flex;gap:14px;align-items:center}.miniName{font-size:13px;font-weight:800}.primary{background:linear-gradient(110deg,#a78bfa,#7c6af0);color:#0a0b13;border-radius:10px;padding:12px 16px;font-size:12px;font-weight:800;box-shadow:0 6px 24px #8b5cf633}.primary:hover{filter:brightness(1.08);transform:translateY(-1px)}.big{padding:15px 20px;font-size:13px}.hero{min-height:560px;display:grid;grid-template-columns:1fr .85fr;align-items:center;position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(ellipse at 80% 45%,#6c4ad51c,transparent 43%),radial-gradient(ellipse at 10% 10%,#1c647a18,transparent 40%)}.heroContent{padding:76px 0;position:relative;z-index:2}.eyebrow{font:11px 'DM Mono',monospace;letter-spacing:2px;color:var(--accent2);text-transform:uppercase;display:flex;align-items:center;gap:9px}.pulse,.serverDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#5ef0b5;box-shadow:0 0 12px #5ef0b5}.hero h1{font-size:clamp(45px,6vw,84px);line-height:.99;letter-spacing:-4px;margin:24px 0;font-weight:800}.hero h1 em,h2 em{font-style:normal;color:var(--accent)}.hero p{max-width:480px;color:#aab1c3;font-size:15px;line-height:1.8}.heroActions{display:flex;gap:12px;margin-top:28px}.heroArt{height:440px;position:relative;display:grid;place-items:center;isolation:isolate}.heroArt:before{content:'';position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,#9a6cff33,transparent 68%);filter:blur(10px)}.ring{position:absolute;border:1px solid #a78bfa30;border-radius:50%;transform:rotate(-24deg)}.ring1{width:360px;height:260px}.ring2{width:290px;height:420px;transform:rotate(55deg);border-color:#67e8f927}.cube{width:160px;height:160px;display:grid;place-items:center;font-size:90px;font-weight:900;color:#dcd1ff;text-shadow:0 0 30px #a78bfa;transform:rotate(-9deg);border:1px solid #c4b5fd70;background:linear-gradient(145deg,#a78bfa28,#67e8f914);box-shadow:inset 0 0 60px #a78bfa20,0 0 100px #8b5cf622;clip-path:polygon(15% 0,85% 0,100% 15%,100% 85%,85% 100%,15% 100%,0 85%,0 15%)}.floatTag{position:absolute;padding:11px 15px;border:1px solid #ffffff22;border-radius:9px;background:#101421d9;backdrop-filter:blur(10px);font-size:15px;color:var(--accent2)}.floatTag span{font:10px 'DM Mono';letter-spacing:1px;color:#e2e5f1}.tagOne{top:80px;right:20px}.tagTwo{bottom:77px;left:15px}.serverAddress{display:flex;align-items:center;gap:12px;margin-top:34px;padding:13px 15px;width:max-content;max-width:100%;background:#111521;border:1px solid var(--line);border-radius:12px}.serverAddress div{display:grid;gap:4px}.serverAddress small{font:9px 'DM Mono';letter-spacing:1px;color:var(--muted)}.serverAddress strong{font:13px 'DM Mono'}.serverAddress button{background:#ffffff0c;padding:8px 10px;border-radius:7px;font-size:10px;color:#c5cbe0}.stats{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}.stats div{padding:26px 20px;display:grid;gap:7px;border-right:1px solid var(--line)}.stats div:first-child{padding-left:0}.stats div:last-child{border:0}.stats strong{font-size:25px;color:var(--accent)}.stats span{font:9px 'DM Mono';letter-spacing:1.3px;color:var(--muted)}.section{padding:72px 0}.sectionHead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px}.section h2,.panel h2{font-size:clamp(29px,4vw,43px);letter-spacing:-1.5px;margin:12px 0 26px}.sectionHead h2{margin-bottom:0}.sectionHead>p,.muted{color:var(--muted);font-size:13px;line-height:1.8;max-width:360px}.featureGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.feature,.product,.panel,.rule,.player{background:linear-gradient(145deg,#131827,#0f131e);border:1px solid var(--line);border-radius:16px;padding:24px}.feature>span{font-size:26px;color:var(--accent2)}.feature h3,.product h3{font-size:17px;margin:25px 0 10px}.feature p,.product p,.rule p{color:var(--muted);font-size:12px;line-height:1.8;min-height:44px}.feature button{background:none;color:var(--accent2);font-size:11px;font-weight:800;margin-top:14px;padding:0}.notice{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:13px 17px;margin:16px 0;border:1px solid #a78bfa55;background:#a78bfa12;border-radius:10px;color:#ddd5ff;font-size:12px}.notice button{background:none;font-size:20px}.subtle{color:#c6cce0}.authPanel{max-width:480px;margin:60px auto}.authPanel h2{margin-bottom:8px}.form{display:flex;flex-direction:column;gap:17px}.form label{display:flex;flex-direction:column;gap:8px;font-size:11px;font-weight:700;color:#cbd0df}.form input,.form textarea,.form select,.searchLine input{width:100%;background:#090d16;border:1px solid #30374a;color:white;border-radius:9px;padding:12px;outline:none;font-size:13px}.form textarea{min-height:105px;resize:vertical}.form input:focus,.form textarea:focus,.form select:focus,.searchLine input:focus{border-color:var(--accent)}.textButton{background:none;color:var(--accent2);font-size:12px;margin-top:20px;padding:0}.profileBanner{display:flex;align-items:center;gap:20px;min-height:220px;padding:30px;background:linear-gradient(100deg,#1e2440,#121827);background-size:cover;background-position:center;border:1px solid var(--line);border-radius:17px;margin-bottom:18px}.avatar{width:90px;height:90px;flex-shrink:0;display:grid;place-items:center;background:#2d2447;border:3px solid #bba7ff;border-radius:22px;font-size:36px;font-weight:800;overflow:hidden}.avatar img,.smallAvatar img{width:100%;height:100%;object-fit:cover}.profileBanner h2{margin:8px 0 4px;font-size:30px}.profileBanner p{margin:0;color:var(--muted);font-size:12px}.profileBadges{display:flex;gap:7px;flex-wrap:wrap;margin-left:auto;align-self:flex-end}.profileBadges span{background:#090b12b8;border:1px solid #ffffff20;padding:7px 9px;border-radius:7px;font-size:10px}.profileLayout{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel h3{margin:0 0 8px}.colorInput{display:flex;align-items:center;gap:12px}.colorInput input{width:45px;height:35px;padding:3px}.colorInput code{font:12px 'DM Mono';color:var(--muted)}.balance{display:grid;gap:10px;padding:17px;background:#a78bfa0c;border:1px solid #a78bfa40;border-radius:12px}.balance small{font:9px 'DM Mono';letter-spacing:1px;color:var(--muted)}.balance strong{font-size:25px}.balance strong span{font-size:11px;color:var(--muted)}.tiny{font-size:10px;line-height:1.7;color:#7e879e}.switch{display:flex;background:#111521;border:1px solid var(--line);border-radius:10px;padding:4px}.switch button{background:transparent;padding:10px 14px;border-radius:7px;color:var(--muted);font-size:11px}.switch button.selected{background:#a78bfa;color:#090b12;font-weight:800}.productGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.product{position:relative;display:flex;flex-direction:column;min-height:280px}.productIcon{display:grid;place-items:center;width:48px;height:48px;border-radius:13px;background:#a78bfa18;border:1px solid #a78bfa50;color:var(--accent);font-size:24px}.category{font:9px 'DM Mono';letter-spacing:1.2px;color:var(--accent2);margin-top:18px}.product h3{margin:9px 0}.product p{min-height:40px;flex:1}.priceLine{display:flex;align-items:center;gap:9px;margin:10px 0 15px}.priceLine strong{font-size:18px}.priceLine span{font-size:10px;background:#5ef0b51b;color:#5ef0b5;border-radius:5px;padding:4px}.product .primary{width:100%}.rule{margin:12px 0}.rule h3{margin:0 0 10px}.rule p{min-height:0;margin:0}.searchLine{display:flex;gap:10px;max-width:520px;margin:20px 0}.playerGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.player{display:flex;align-items:center;gap:10px;flex-direction:column}.player strong{font-size:13px}.player span{font-size:10px;color:var(--muted)}.smallAvatar{width:50px;height:50px;border-radius:14px;font-size:19px}.adminGrid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.userList{display:grid;gap:6px;max-height:350px;overflow:auto;margin:6px 0 10px}.userRow{display:grid;text-align:left;gap:4px;background:#090d16;border:1px solid #262d3f;border-radius:8px;padding:10px}.userRow.active{border-color:var(--accent);background:#a78bfa12}.userRow strong{font-size:12px}.userRow span,.userRow small{font-size:10px;color:var(--muted)}hr{width:100%;border:0;border-top:1px solid var(--line);margin:5px 0}footer{border-top:1px solid var(--line);padding:27px 0;display:flex;align-items:center;gap:22px;color:var(--muted);font-size:10px}footer .brand{margin-right:auto;color:white} @media(max-width:850px){main{padding:0 18px}.top{height:auto;min-height:70px;flex-wrap:wrap;gap:10px;padding:13px 0}.top nav{order:3;flex-basis:100%;overflow:auto}.top nav button{white-space:nowrap;padding:9px}.right{margin-left:auto}.hero{grid-template-columns:1fr;min-height:0}.heroContent{padding:60px 0 25px}.heroArt{height:300px}.ring1{width:260px;height:190px}.ring2{width:220px;height:300px}.cube{width:120px;height:120px;font-size:65px}.tagOne{top:20px;right:12%}.tagTwo{bottom:35px;left:8%}.stats{grid-template-columns:repeat(2,1fr)}.stats div{padding:20px!important;border-bottom:1px solid var(--line)}.featureGrid,.productGrid{grid-template-columns:repeat(2,1fr)}.sectionHead{align-items:start;flex-direction:column}.profileLayout,.adminGrid{grid-template-columns:1fr}.playerGrid{grid-template-columns:repeat(3,1fr)}}@media(max-width:540px){main{padding:0 13px}.hero h1{letter-spacing:-2px}.heroActions{flex-wrap:wrap}.serverAddress{width:100%;gap:8px}.serverAddress button{margin-left:auto}.featureGrid,.productGrid{grid-template-columns:1fr}.profileBanner{align-items:flex-start;flex-wrap:wrap;padding:18px}.avatar{width:68px;height:68px;border-radius:17px}.profileBanner h2{font-size:24px}.profileBadges{margin-left:0;flex-basis:100%}.playerGrid{grid-template-columns:repeat(2,1fr)}.section{padding:48px 0}.panel{padding:18px}.stats span{font-size:8px}footer{flex-wrap:wrap}footer .brand{flex-basis:100%}}
