'use client';

import { useEffect, useRef, useState } from 'react';
import Link from 'next/link';
import { useSearchParams } from 'next/navigation';

export default function VerifyEmailPage() {
  const searchParams = useSearchParams();
  const token = searchParams.get('token');
  const started = useRef(false);
  const [status, setStatus] = useState('loading');
  const [message, setMessage] = useState('Проверяем ссылку подтверждения…');

  useEffect(() => {
    if (started.current) return;
    started.current = true;

    if (!token) {
      setStatus('error');
      setMessage('В ссылке отсутствует токен подтверждения.');
      return;
    }

    fetch('/api/auth/verify-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
    })
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.message || data.error || 'Не удалось подтвердить email.');
        }
        return data;
      })
      .then((data) => {
        setStatus('success');
        setMessage(data.message || 'Email успешно подтверждён!');
      })
      .catch((error) => {
        setStatus('error');
        setMessage(error.message || 'Произошла ошибка подтверждения.');
      });
  }, [token]);

  return (
    <main style={{
      minHeight: '100vh',
      display: 'grid',
      placeItems: 'center',
      padding: 24,
      background: '#0b0d12',
      color: '#f5f5f5',
      fontFamily: 'Arial, sans-serif',
    }}>
      <section style={{
        width: '100%',
        maxWidth: 440,
        padding: 28,
        border: '1px solid #292d38',
        borderRadius: 18,
        background: '#141720',
        textAlign: 'center',
      }}>
        <h1 style={{ fontSize: 28, marginBottom: 16 }}>
          Hypego
        </h1>
        <h2 style={{ fontSize: 21, marginBottom: 14 }}>
          {status === 'loading'
            ? 'Подтверждение email'
            : status === 'success'
              ? 'Email подтверждён!'
              : 'Не удалось подтвердить email'}
        </h2>
        <p style={{ color: '#c2c6d0', lineHeight: 1.6 }}>
          {message}
        </p>
        {status !== 'loading' && (
          <Link href="/" style={{
            display: 'inline-block',
            marginTop: 22,
            padding: '12px 22px',
            borderRadius: 10,
            background: '#5865f2',
            color: '#fff',
            textDecoration: 'none',
          }}>
            Вернуться на главную
          </Link>
        )}
      </section>
    </main>
  );
}
